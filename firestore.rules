rules_version = '2';

// Guyub Firestore security rules.
// Role and organization come from Firebase Auth custom claims:
//   request.auth.token.role  -> "admin" | "organizer" | "committee" | "attendee"
//   request.auth.token.orgId -> organization id (organizer and committee only)
// Claims are set only by the Cloud Function `setUserClaims` (Admin SDK).
// Clients cannot write claims, so these rules can trust them.
//
// Committee scope is per event: a committee member may act on an event only
// if a document exists at events/{eventId}/committees/{uid}.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Users without a role claim are attendees (fresh Google sign-ups).
    function role() {
      return request.auth.token.get('role', 'attendee');
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isOrganizer() {
      return signedIn() && role() == 'organizer';
    }

    function isCommittee() {
      return signedIn() && role() == 'committee';
    }

    function sameOrg(orgId) {
      return signedIn() && request.auth.token.get('orgId', null) == orgId;
    }

    // True when the caller is a committee member assigned to this event.
    function isAssignedCommittee(eventId) {
      return isCommittee()
        && exists(/databases/$(database)/documents/events/$(eventId)/committees/$(request.auth.uid));
    }

    // ---- users/{uid} -------------------------------------------------
    // A user reads their own profile. Admin reads all. An organizer reads
    // profiles of their own org's members (to manage the committee).
    // Only the Admin SDK writes users (role and orgId are sensitive).
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isOrganizer() && sameOrg(resource.data.organization_id))
      );
      allow write: if false;
    }

    // ---- organizations/{orgId} --------------------------------------
    // Created by admin. The document ID is the slug. Any signed-in user can
    // read organizations: the name is public and attendees see it on event
    // cards. Organizations are never deleted from the client.
    match /organizations/{orgId} {
      function isValidOrgName(data) {
        return data.name is string && data.name.size() >= 2 && data.name.size() <= 80;
      }

      allow read: if signedIn();

      allow create: if isAdmin()
        && orgId.matches('^[a-z0-9][a-z0-9-]{1,39}$')
        && request.resource.data.keys().hasOnly(['name', 'slug', 'status', 'created_by', 'created_at'])
        && isValidOrgName(request.resource.data)
        && request.resource.data.slug == orgId
        && request.resource.data.status == 'active'
        && request.resource.data.created_by == request.auth.uid;

      allow update: if isAdmin()
        && isValidOrgName(request.resource.data)
        && request.resource.data.slug == resource.data.slug;

      allow delete: if false;
    }

    // ---- invites/{email} ----------------------------------------------
    // Pending role invites for people who have not signed in yet.
    // Written only by the inviteMember Cloud Function and consumed by
    // onUserCreated. Organizers see their org's invites and may cancel
    // committee invites.
    match /invites/{email} {
      allow read: if isAdmin() || (isOrganizer() && sameOrg(resource.data.organization_id));
      allow delete: if isAdmin()
        || (isOrganizer() && sameOrg(resource.data.organization_id) && resource.data.role == 'committee');
      allow create, update: if false;
    }

    // ---- events/{eventId} -------------------------------------------
    // Any signed-in user can browse active events.
    // Organizer of the owning org manages drafts and events.
    // Assigned committee reads the event it scans for.
    match /events/{eventId} {
      // Shape of an event document. Mirrors EventDraft in the Flutter app.
      function isValidEvent(data) {
        return data.keys().hasAll(['organization_id', 'title', 'status', 'registration_open', 'date', 'created_by'])
          && data.keys().hasOnly([
            'organization_id', 'title', 'description', 'location', 'date', 'capacity',
            'status', 'registration_open', 'banner_url', 'certificate_template_url',
            'registered_count', 'created_by', 'created_at', 'updated_at'
          ])
          && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
          && data.status in ['draft', 'active', 'completed']
          && data.registration_open is bool
          // Registration can only be open while the event is published.
          && (data.registration_open == false || data.status == 'active')
          && data.date is timestamp
          && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
          && (!('location' in data) || (data.location is string && data.location.size() <= 200))
          && (!('capacity' in data) || data.capacity == null
              || (data.capacity is int && data.capacity > 0 && data.capacity <= 100000));
      }

      // draft <-> active, active -> completed. Completed is final: it locks check-in.
      function isValidTransition(before, after) {
        return before == after
          || (before == 'draft' && after == 'active')
          || (before == 'active' && (after == 'draft' || after == 'completed'));
      }

      // registered_count is maintained only by the registerForEvent and
      // cancelRegistration Cloud Functions.
      function registeredCount(data) {
        return data.get('registered_count', 0);
      }

      // Committee sees only events it is assigned to (per-event scope, SPEC §0.3).
      // A registered attendee keeps seeing the event after it is completed or
      // moved back to draft, so their ticket still shows its details.
      allow read: if isAdmin()
        || (signedIn() && resource.data.status == 'active')
        || (isOrganizer() && sameOrg(resource.data.organization_id))
        || isAssignedCommittee(eventId)
        || (signedIn() && exists(/databases/$(database)/documents/attendance/$(eventId + '_' + request.auth.uid)));

      // New events always start as drafts with nobody registered.
      allow create: if isOrganizer()
        && sameOrg(request.resource.data.organization_id)
        && isValidEvent(request.resource.data)
        && request.resource.data.status == 'draft'
        && registeredCount(request.resource.data) == 0
        && request.resource.data.created_by == request.auth.uid;

      allow update: if isOrganizer()
        && sameOrg(resource.data.organization_id)
        && isValidEvent(request.resource.data)
        && request.resource.data.organization_id == resource.data.organization_id
        && request.resource.data.created_by == resource.data.created_by
        && registeredCount(request.resource.data) == registeredCount(resource.data)
        && isValidTransition(resource.data.status, request.resource.data.status);

      // Only drafts nobody registered for can be deleted. A published event
      // moved back to draft may still have tickets.
      allow delete: if isOrganizer()
        && sameOrg(resource.data.organization_id)
        && resource.data.status == 'draft'
        && registeredCount(resource.data) == 0;

      // ---- events/{eventId}/committees/{uid} ----------------------
      // Organizer assigns committee members to their own org's events.
      // The assignee must be a committee member of the same org. The
      // users/{uid} profile mirrors the claims (written by applyRole).
      match /committees/{uid} {
        function eventOrg() {
          return get(/databases/$(database)/documents/events/$(eventId)).data.organization_id;
        }

        function assignee() {
          return get(/databases/$(database)/documents/users/$(uid)).data;
        }

        allow read: if isAdmin()
          || (signedIn() && request.auth.uid == uid)
          || (isOrganizer() && sameOrg(eventOrg()));

        allow create: if isOrganizer()
          && sameOrg(eventOrg())
          && request.resource.data.keys().hasOnly(['uid', 'organization_id', 'display_name', 'email', 'assigned_by', 'assigned_at'])
          && request.resource.data.uid == uid
          && request.resource.data.organization_id == eventOrg()
          && request.resource.data.assigned_by == request.auth.uid
          && assignee().role == 'committee'
          && assignee().organization_id == eventOrg();

        allow update: if false;

        allow delete: if isOrganizer() && sameOrg(eventOrg());
      }
    }

    // A committee member lists their own assignments across all events
    // (collection group query on `committees` filtered by uid).
    match /{path=**}/committees/{assignment} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- attendance/{attendanceId} ----------------------------------
    // ID is `${eventId}_${uid}` so one person cannot register twice.
    //
    // Create: only the registerForEvent Cloud Function. It checks consent,
    //         registration state, and capacity in one transaction, and
    //         issues the secret qr_token. Clients cannot do either safely.
    // Read:   attendee (own), admin, organizer of the org,
    //         committee assigned to the event.
    // Update: assigned committee may only set check-in fields, and only
    //         to checked-in. Certificate and QR fields are Cloud Functions only.
    // Delete: only cancelRegistration (frees the spot). Never from clients.
    match /attendance/{attendanceId} {

      allow create: if false;

      // Committee also carries an orgId, so the org branch is organizer-only.
      // Otherwise every committee member could read the whole org's attendance.
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid
        || isAdmin()
        || (isOrganizer() && sameOrg(resource.data.organization_id))
        || isAssignedCommittee(resource.data.event_id)
      );

      allow update: if isAssignedCommittee(resource.data.event_id)
        && get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['is_checked_in', 'checked_in_at', 'checked_in_by'])
        && request.resource.data.is_checked_in == true
        && request.resource.data.checked_in_by == request.auth.uid;

      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
