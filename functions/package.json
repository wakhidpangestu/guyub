{
  "name": "guyub-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Guyub backend: auth claims, check-in and certificate automation",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "set-role": "npm run build && node --experimental-strip-types scripts/set-role.mts",
    "seed": "npm run build && node --experimental-strip-types scripts/seed-emulator.mts",
    "test": "npm run build && node --experimental-strip-types --test test/claims.test.mts"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  }
}
