{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "guyub",
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "public": "apps/dashboard/build/web-e2e",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "hosting": { "port": 15000 },
    "auth": { "port": 19099 },
    "firestore": { "port": 18080, "websocketPort": 19150 },
    "functions": { "port": 15001 },
    "storage": { "port": 19199 },
    "hub": { "port": 14400 },
    "logging": { "port": 14500 },
    "eventarc": { "port": 19299 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
