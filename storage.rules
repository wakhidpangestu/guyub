rules_version = '2';

// Storage layout:
//   events/{eventId}/banner.*            organizer of the event's org writes
//   events/{eventId}/certificate-template.pdf   organizer writes
//   sponsors/{orgId}/logo.*              org members write
//   certificates/{eventId}/{uid}.pdf     Cloud Functions write; owner reads

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isOrganizer() {
      return signedIn() && request.auth.token.role == 'organizer';
    }

    function sameOrg(orgId) {
      return signedIn() && request.auth.token.orgId == orgId;
    }

    // Event assets: public read (banners), org-scoped write, size and type limits.
    match /events/{eventId}/{file} {
      allow read: if true;
      allow write: if (isAdmin() || isOrganizer())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Sponsor logos: org-scoped.
    match /sponsors/{orgId}/{file} {
      allow read: if signedIn();
      allow write: if (isAdmin() || sameOrg(orgId))
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Certificates: owner reads own file. Only Admin SDK (Cloud Functions) writes.
    match /certificates/{eventId}/{uid}.pdf {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
